PORT=5000
MONGODB_URI=mongodb://localhost:27017/dev-canvas
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_long_random_secret
NODE_ENV=development
FORCE_HTTPS=false
ADMIN_EMAILS=admin@example.com

# Google OAuth / OIDC provider settings
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret

# Optional strict OIDC bearer token validation for cloud IdP access tokens / ID tokens
OIDC_ISSUER=https://accounts.google.com
OIDC_AUDIENCE=replace_with_oidc_client_id_or_api_audience
OIDC_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret
