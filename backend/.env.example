PORT=5000
MONGODB_URI=mongodb://localhost:27017/dev-canvas
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_long_random_secret
NODE_ENV=development
FORCE_HTTPS=false
ADMIN_EMAILS=admin@example.com

# Asgardeo OIDC provider settings
SERVER_URL=http://localhost:5000
ASGARDEO_ORG_NAME=replace_with_asgardeo_organization_name
ASGARDEO_CLIENT_ID=replace_with_asgardeo_client_id
ASGARDEO_CLIENT_SECRET=replace_with_asgardeo_client_secret
ASGARDEO_CALLBACK_URL=http://localhost:5000/api/auth/asgardeo/callback
ASGARDEO_BASE_URL=https://api.asgardeo.io/t/replace_with_asgardeo_organization_name
ASGARDEO_AUTHORIZE_ENDPOINT=https://api.asgardeo.io/t/replace_with_asgardeo_organization_name/oauth2/authorize
ASGARDEO_TOKEN_ENDPOINT=https://api.asgardeo.io/t/replace_with_asgardeo_organization_name/oauth2/token
ASGARDEO_LOGOUT_ENDPOINT=https://api.asgardeo.io/t/replace_with_asgardeo_organization_name/oidc/logout

# Legacy Google OAuth settings
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret

# Strict OIDC bearer token validation for Asgardeo tokens
OIDC_ISSUER=https://api.asgardeo.io/t/replace_with_asgardeo_organization_name/oauth2/token
OIDC_AUDIENCE=replace_with_asgardeo_client_id
OIDC_JWKS_URI=https://api.asgardeo.io/t/replace_with_asgardeo_organization_name/oauth2/jwks

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret
